# --- Required (never commit real values) ---
# Agora Console -> project with Conversational AI enabled (and Signaling/RTM enabled for transcripts)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional: Agora RESTful API key (Agora Console > Developer Toolkit > RESTful API). Used for Conversational AI REST calls when set.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- Connected systems (all optional; nothing is sent until one is set) ---
# Any HTTPS endpoint (Zapier, Make, n8n, Power Automate, ERP/CMMS middleware). Body is JSON; signed with WEBHOOK_SECRET.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Slack incoming webhook / Microsoft Teams incoming webhook or Workflows URL
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# Jira Cloud: issues for escalations and follow-ups
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# GitHub Issues (owner/name): issues for escalations and follow-ups
GITHUB_TOKEN=
GITHUB_REPO=
# Telegram: bot from @BotFather, added to the team's group. Messages carry links; handoffs attach the report (HTML + Excel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp Cloud API (Meta): text with links; handoffs attach the Excel report. Outside a 24-hour reply window only
# approved templates are delivered: set WHATSAPP_TEMPLATE (one body parameter) and WHATSAPP_TEMPLATE_LANG (e.g. en).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
# Excel Online (Power Automate "When an HTTP request is received" -> "Add a row into a table") or Google Sheets (Apps
# Script web app). One flat row per event, with the handoff report, Excel and audit-log links.
SPREADSHEET_WEBHOOK_URL=
# Where links in messages point (the console's address on the site network). Default http://localhost:8000.
PUBLIC_CONSOLE_URL=
# Murf API key (Murf Falcon TTS via Agora is BYOK only)
MURF_API_KEY=

# --- Optional ---
# Murf voice for Falcon (verify against your Murf account's voice list)
MURF_VOICE_ID=en-IN-isha
MURF_LOCALE=en-IN
# Agora-managed vision-capable LLM: gpt-4o-mini | gpt-4.1-mini | gpt-5-mini | gpt-5-nano
AGORA_LLM_MODEL=gpt-4o-mini
# Stable public endpoint for the MCP port (recommended): ngrok authtoken + free static domain
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Leave empty to auto-start a tunnel (ngrok if NGROK_AUTHTOKEN is set, else a Cloudflare quick tunnel) for the MCP port. Set to use your own (e.g. ngrok) URL.
MCP_PUBLIC_URL=
# Bearer token Agora presents to the MCP server. Random per run if empty.
MCP_TOKEN=
API_PORT=8000
MCP_PORT=8001

# --- Hosting (Render or any container host; see README "Deploy") ---
# One public port ($PORT) serves the console and /mcp together; MCP_PUBLIC_URL is then the service's https URL.
# SHIFTTRACE_SINGLE_PORT=1
# Required when the console is reachable from the internet (HTTP Basic auth, any user name).
CONSOLE_PASSWORD=

# Which scenario packs to load on reset (demo_data/packs/<id>), comma-separated. Default: all.
# SHIFTTRACE_PACKS=compressor_house,packaging_line,building_hvac
